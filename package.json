{
  "name": "repodash",
  "version": "1.1.2",
  "description": "Generate an interactive GitHub-style insights dashboard for any local git repository",
  "type": "module",
  "license": "GPL-3.0",
  "bin": {
    "repodash": "bin/repodash.js"
  },
  "scripts": {
    "start": "node bin/repodash.js",
    "test": "node --test tests/**/*.test.js tests/**/*.e2e.js",
    "test:e2e": "node --test tests/**/*.e2e.js",
    "lint": "eslint .",
    "lint:md": "markdownlint --ignore node_modules --ignore docs/superpowers --ignore .husky --ignore AGENTS.md .",
    "lint:css": "stylelint '**/*.css'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reviewdog": "reviewdog",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "open": "^10.2.0"
  },
  "files": [
    "bin/",
    "src/",
    "dashboard/"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "git",
    "repodash",
    "dashboard",
    "cli"
  ],
  "author": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-rdjson": "^1.0.6",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "markdownlint-cli": "^0.48.0",
    "playwright": "^1.61.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
